# GEMINI_API_KEY: Required for Gemini 3 Flash AI search calls on the server.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Secret key used to sign HTTP-only session cookies and tokens.
# Defaults to an ephemeral per-process secret if omitted in local preview.
SESSION_SECRET="change-me-to-a-strong-random-32-byte-secret"

# USE_MOCK_DRIVE: Set to "true" for built-in Malaysian SSM demo seed data,
# or "false" to connect to a live Google Drive mirrored repository.
USE_MOCK_DRIVE="true"

# GOOGLE_SERVICE_ACCOUNT_EMAIL: Service Account email with Read-Only ("Viewer")
# access to the mirrored root CoSec_Clients Google Drive folder.
GOOGLE_SERVICE_ACCOUNT_EMAIL=""

# GOOGLE_PRIVATE_KEY: Private key from your Google Cloud Service Account JSON
# (escape newlines as \n when storing in .env).
GOOGLE_PRIVATE_KEY=""

# COSEC_WHATSAPP_NUMBER: Target Malaysian WhatsApp number in international format
# (without leading + or spaces) for Certified True Copy (CTC) requests.
COSEC_WHATSAPP_NUMBER="601136768398"
